# Enterprise Analytics Platform - Environment Variables
# Copy this file to .env and update the values

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics_warehouse
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=your_secure_password_here

# Airflow Configuration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://analytics_user:your_secure_password_here@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_webserver_secret_key_here
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Data Paths
RAW_DATA_PATH=/data/raw
PROCESSED_DATA_PATH=/data/processed
SAMPLE_DATA_PATH=/data/sample

# API Keys (for external data sources)
EXCHANGE_RATE_API_KEY=your_api_key_here

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Metabase Configuration
METABASE_HOST=localhost
METABASE_PORT=3000

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501

# Data Quality Thresholds
DQ_NULL_THRESHOLD=0.05
DQ_DUPLICATE_THRESHOLD=0.01
DQ_FRESHNESS_HOURS=24

